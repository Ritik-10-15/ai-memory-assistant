# SITE_ADDRESS is the instance's public IP. Let's Encrypt issues IP-address
# certificates only under its short-lived (~6 day) profile; Caddy renews them
# automatically. Using the bare IP avoids wildcard-DNS hostnames (sslip.io,
# nip.io), which many network filters block.
{
	# Clients send no SNI when connecting to an IP, so tell Caddy which
	# certificate to present in that case.
	default_sni {$SITE_ADDRESS}
}

{$SITE_ADDRESS} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	encode gzip
	# Don't advertise server software (the app's own or Caddy's).
	header -Server
	reverse_proxy app:8000 {
		header_down -Server
	}
}
