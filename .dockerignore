# Keep secrets, personal data and local-only files out of the image.
.env
.git
.github
.vscode
.pytest_cache
__pycache__/
*.pyc
venv/
.venv/

# Personal / biometric data — lives on the /data volume instead
known_faces/
uploads/
photos/
memory_v2.db*
*.db-wal
*.db-shm
gallery_cache.npz

# Downloaded inside the image build
models/

# Large local-only files
*.exe
assets/
tests/

# Deployment secrets and infra files
.env.*
aws/
docker-compose*.yml

# Frontend: dependencies and build output are produced inside the image
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/dist-demo/
