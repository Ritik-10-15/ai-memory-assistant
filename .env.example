# Copy to .env and fill in. Never commit .env (it is git- and docker-ignored).
# The private app refuses to start under gunicorn while any REQUIRED value is
# missing or left at its development default.

# ── Required ──────────────────────────────────────────────────────────
# Caregiver workspace password. Use a long passphrase.
CAREGIVER_PASSWORD=
# PIN typed once on the patient's device (it then stays signed in for a year).
PATIENT_PIN=
# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Deployment ────────────────────────────────────────────────────────
# 1 when the site is served over HTTPS (cookies become Secure, HSTS is sent).
# Leave 0 for http://localhost.
SECURE_COOKIES=0
# 1 only behind a reverse proxy that sets X-Forwarded-For (Caddy on AWS).
TRUST_PROXY=0
# Optional: host names this server answers for, comma-separated.
ALLOWED_HOSTS=
# DEBUG, INFO (default), WARNING or ERROR.
LOG_LEVEL=INFO

# ── Sandbox server (public "try it yourself") ─────────────────────────
# 1: visitors sign up for their own private, temporary copy instead of using
# the caregiver password and PIN above (which are then not needed). Never
# enable on a server that holds a real household's data.
SANDBOX_MODE=0
# Days before a sandbox and all its files are deleted; live sandboxes at once.
SANDBOX_DAYS=7
SANDBOX_MAX=50

# ── Optional features ─────────────────────────────────────────────────
# Summarise transcribed voice memos with an LLM. Leave empty to keep raw
# transcripts (voice memos also need Whisper, which the Docker image omits).
OPENAI_API_KEY=

# ── Local compose ports (compose.yaml) ────────────────────────────────
APP_PORT=8000
DEMO_PORT=8080
